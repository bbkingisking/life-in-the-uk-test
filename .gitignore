# Build output (none is checked in; this is here in case a binary gets built in-place)
/liuk

# Regenerated fresh on every deploy (see deploy.yml's "Generate Island walk
# pools" step, `go run ./cmd/liuk leanwalk`) - a checked-in copy would only
# ever be stale, and it's an ~18MB JSON blob, not something to carry in git
# history. Run `go run ./cmd/liuk leanwalk dist/island-walk-pools.json`
# locally to populate it for testing "Island walk" mode.
/dist/island-walk-pools.json

# Full Shoelace mirror for local browsing/experimentation (see
# vendor/shoelace-full/README.md) - never vendor this wholesale; the
# real dist/vendor/shoelace/ only ever holds the closure of components
# actually used.
/vendor/shoelace-full/
/playground.html

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
